# Where PDFs, the index and datasets are stored
PAPERRAG_DATA_DIR=data
PAPERRAG_INDEX_DIR=data/index
# Models (Hugging Face hub ids). Use PAPERRAG_EMBEDDER=hashing / PAPERRAG_RERANKER=lexical for download-free mode.
PAPERRAG_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
PAPERRAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
PAPERRAG_EMBEDDER=sentence-transformers
PAPERRAG_RERANKER=cross-encoder
# Retrieval
PAPERRAG_CANDIDATES_PER_RETRIEVER=50
PAPERRAG_RERANK_TOP_N=20
PAPERRAG_TOP_K=5
# Answering: extractive (no key needed) or anthropic
PAPERRAG_GENERATOR=extractive
PAPERRAG_ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
